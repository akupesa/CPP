#include "ShrubberyCreationForm.hpp"

// Construtor padrão
// Inicializa AForm com nome "ShrubberyCreationForm", grade para assinar 145, grade para executar 137
ShrubberyCreationForm::ShrubberyCreationForm()
    : AForm("ShrubberyCreationForm", 145, 137), target("default")
{
    std::cout << "ShrubberyCreationForm default constructor called" << std::endl;
}

// Construtor parametrizado
// Recebe o target (local onde plantar as árvores)
ShrubberyCreationForm::ShrubberyCreationForm(const std::string& target)
    : AForm("ShrubberyCreationForm", 145, 137), target(target)
{
    std::cout << "ShrubberyCreationForm constructor called for target: " << target << std::endl;
}

// Construtor de cópia
// Copia tanto os atributos de AForm quanto o target
ShrubberyCreationForm::ShrubberyCreationForm(const ShrubberyCreationForm& other)
    : AForm(other), target(other.target)
{
    std::cout << "ShrubberyCreationForm copy constructor called" << std::endl;
}

// Operador de atribuição
// Chama o operador de atribuição da classe base e copia o target
ShrubberyCreationForm& ShrubberyCreationForm::operator=(const ShrubberyCreationForm& other)
{
    std::cout << "ShrubberyCreationForm assignment operator called" << std::endl;
    if (this != &other)
    {
        AForm::operator=(other);  // Chama o operador da classe base
        this->target = other.target;
    }
    return *this;
}

// Destrutor
ShrubberyCreationForm::~ShrubberyCreationForm()
{
    std::cout << "ShrubberyCreationForm destructor called" << std::endl;
}

// Getter para target
std::string ShrubberyCreationForm::getTarget() const
{
    return this->target;
}

// Implementação do método virtual puro executeAction()
// Este método é chamado por AForm::execute() após todas as validações
void ShrubberyCreationForm::executeAction() const
{
    // Cria o nome do arquivo: <target>_shrubbery
    std::string filename = this->target + "_shrubbery";
    
    // Abre o arquivo para escrita
    std::ofstream file(filename.c_str());  // .c_str() necessário para C++98
    
    // Verifica se o arquivo foi aberto com sucesso
    if (!file.is_open())
    {
        std::cerr << "Error: Could not create file " << filename << std::endl;
        return;
    }

    // Escreve árvores ASCII no arquivo
    // Primeira árvore
    file << "       ###" << std::endl;
    file << "      #o###" << std::endl;
    file << "    #####o###" << std::endl;
    file << "   #o#\\#|#/###" << std::endl;
    file << "    ###\\|/#o#" << std::endl;
    file << "     # }|{  #" << std::endl;
    file << "       }|{" << std::endl;
    file << std::endl;
    
    // Segunda árvore
    file << "      /\\*/\\" << std::endl;
    file << "     /\\-|-/\\" << std::endl;
    file << "    /\\ }|{ /\\" << std::endl;
    file << "   /  \\}|{/  \\" << std::endl;
    file << "        }|{" << std::endl;
    file << "        }|{" << std::endl;
    file << "   ^^^^^^^^^^^" << std::endl;
    
    // Terceira árvore (opcional - adicional)
    file << std::endl;
    file << "         &&& &&  & &&" << std::endl;
    file << "      && &\\/&\\|& ()|/ @, &&" << std::endl;
    file << "      &\\/(/&/&||/& /_/)_&/_&" << std::endl;
    file << "   &() &\\/&|()|/&\\/ '%\" & ()" << std::endl;
    file << "  &_\\_&&_\\ |& |&&/&__%_/_& &&" << std::endl;
    file << "&&   && & &| &| /& & % ()& /&&" << std::endl;
    file << " ()&_---()&\\&\\|&&-&&--%---()~" << std::endl;
    file << "     &&     \\|||" << std::endl;
    file << "             |||" << std::endl;
    file << "             |||" << std::endl;
    file << "             |||" << std::endl;
    file << "       , -=-~  .-^- _" << std::endl;

    // Fecha o arquivo
    file.close();
    
    // Mensagem de sucesso
    std::cout << "🌲 Shrubbery has been planted at " << this->target << " 🌲" << std::endl;
    std::cout << "File created: " << filename << std::endl;
}